# --- MadGrow web environment ---

# Base URL the browser uses to reach the API.
# Local dev: the API runs on its own port.
#   NEXT_PUBLIC_API_URL="http://localhost:4000"
# Production (single VPS): the API is reverse-proxied under /api on the same
# domain, so a relative path keeps everything first-party (no CORS, cookies
# just work):
#   NEXT_PUBLIC_API_URL="/api"
#
# NOTE: NEXT_PUBLIC_* values are baked in at build time, so set this before
# running `npm run build`.
NEXT_PUBLIC_API_URL="http://localhost:4000"
