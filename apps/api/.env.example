# --- MadGrow API environment ---

# PostgreSQL connection string.
# Local dev example: postgresql://madgrow:madgrow@localhost:5432/madgrow?schema=public
# Production: use the database URL from your VPS/managed Postgres.
DATABASE_URL="postgresql://madgrow:madgrow@localhost:5432/madgrow?schema=public"

# Long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# "production" enables secure cookies + reverse-proxy trust.
NODE_ENV="development"

# Port the API listens on (Nginx proxies to this locally).
PORT=4000

# Browser origin allowed by CORS. In the single-VPS setup the web app and API
# share an origin, so this is only used if you split them onto separate domains.
WEB_ORIGIN="http://localhost:3000"

# --- Optional: paper-trading config (all have sensible defaults) ---
# TRADING_STARTING_BALANCE=1000000
# TRADING_BROKERAGE_PCT=0.03
# TRADING_SLIPPAGE_MAX_PCT=0.05
